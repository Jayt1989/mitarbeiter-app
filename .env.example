# Lokale Entwicklung: `docker compose up -d db` startet PostgreSQL.
DATABASE_URL="postgresql://mitarbeiter:mitarbeiter@localhost:5432/mitarbeiter_app?schema=public"

# Generieren mit `npx auth secret` und hier eintragen.
AUTH_SECRET=""

# Auth.js übernimmt Host/Port aus der Anfrage (localhost und LAN-IP). Kein AUTH_URL setzen.
AUTH_TRUST_HOST=true

# Nur Entwicklung: weitere Hostnamen für den Dev-Server, kommagetrennt, ohne http:// und Port.
ALLOWED_DEV_ORIGINS="192.168.2.40"

# Seed-Zugangsdaten; eigene sichere Werte setzen, bevor `npm run db:seed` läuft.
SEED_ADMIN_PASSWORD=""
SEED_USER_PASSWORD=""
# Nur "true" legt zusätzlich die Demo-/Testmitarbeiter MA-1002 bis MA-1005 samt Beispieldaten an.
# Ohne diese Variable legt der Seed nur Stammdaten und – falls noch nicht vorhanden – den Admin MA-1001 an.
SEED_DEMO_DATA="false"
