generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShiftCode {
  EARLY
  LATE
  NIGHT
  OFF
}

enum VacationStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum AbsenceType {
  SICK
  TRAINING
  SPECIAL_LEAVE
  TIME_OFF
  OTHER
}

enum AbsenceStatus {
  RECORDED
  APPROVED
  REQUESTED
}

enum AssignmentSource {
  ROTATION
  MANUAL
}

enum NotificationType {
  VACATION_REQUESTED
  VACATION_APPROVED
  VACATION_REJECTED
  SHIFT_CHANGED
  ASSIGNMENT_CREATED
  ASSIGNMENT_UPDATED
  ASSIGNMENT_CANCELLED
  QUALIFICATION_ADDED
  SWAP_REQUESTED
  SWAP_PARTNER_CONFIRMED
  SWAP_AWAITING_APPROVAL
  SWAP_PARTNER_REJECTED
  SWAP_APPROVED
  SWAP_REJECTED
  SWAP_CANCELLED
  ADDITIONAL_SHIFT_RELEASED
  ADDITIONAL_SHIFT_UPDATED
  ADDITIONAL_SHIFT_CANCELLED
  MESSAGE_RECEIVED
  MESSAGE_REPLY
}

enum MessageThreadStatus {
  OFFEN
  WARTET_AUF_ANTWORT
  BEANTWORTET
  ERLEDIGT
  ARCHIVIERT
}

enum MessageRecipientType {
  SINGLE
  MULTIPLE
  DEPARTMENT
  SHIFT_GROUP
  ALL
}

model MessageDispatch {
  id                 String               @id
  createdById        String?
  recipientType      MessageRecipientType
  recipientSelection Json
  recipientCount     Int
  requestHash        String
  createdAt          DateTime             @default(now())

  createdBy User?           @relation("MessageDispatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  threads   MessageThread[]

  @@index([createdById, createdAt])
}

model MessageThread {
  id            String              @id @default(cuid())
  dispatchId    String
  subject       String
  createdById   String?
  creatorName   String
  important     Boolean             @default(false)
  replyRequired Boolean             @default(false)
  status        MessageThreadStatus @default(OFFEN)
  version       Int                 @default(1)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  dispatch     MessageDispatch      @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  createdBy    User?                @relation("MessageThreadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants MessageParticipant[]
  messages     Message[]

  @@index([createdById, updatedAt])
}

model MessageParticipant {
  id          String    @id @default(cuid())
  threadId    String
  userId      String?
  employeeId  String?
  name        String
  read        Boolean   @default(false)
  readAt      DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  employee Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([threadId, userId])
  @@unique([threadId, employeeId])
  @@index([userId, read, archivedAt])
  @@index([employeeId, read, archivedAt])
}

model Message {
  id           String    @id @default(cuid())
  threadId     String
  sequence     Int
  senderId     String?
  senderName   String
  content      String
  requestId    String    @unique
  createdAt    DateTime  @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  sender User?         @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt, id])
  @@unique([threadId, sequence])
}

enum AdditionalShiftStatus {
  ENTWURF
  FREIGEGEBEN
  STORNIERT
}

model AdditionalShift {
  id           String                @id @default(cuid())
  employeeId   String
  date         DateTime              @db.Date
  shift        ShiftCode
  departmentId String
  status       AdditionalShiftStatus @default(ENTWURF)
  note         String?
  createdById  String?
  releasedById String?
  releasedAt   DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy  User?      @relation("AdditionalShiftCreator", fields: [createdById], references: [id], onDelete: SetNull)
  releasedBy User?      @relation("AdditionalShiftReleaser", fields: [releasedById], references: [id], onDelete: SetNull)

  @@index([employeeId, date, status])
  @@index([status, date, departmentId])
}

enum ShiftSwapStatus {
  ANGEFRAGT
  PARTNER_BESTAETIGT
  PARTNER_ABGELEHNT
  GENEHMIGT
  ABGELEHNT
  STORNIERT
}

model ShiftSwapRequest {
  id                     String          @id @default(cuid())
  requesterId            String
  partnerId              String
  date                   DateTime        @db.Date
  requesterOriginalShift ShiftCode
  partnerOriginalShift   ShiftCode
  requesterArea          String?
  partnerArea            String?
  status                 ShiftSwapStatus @default(ANGEFRAGT)
  comment                String?
  partnerDecidedAt       DateTime?
  approvedById           String?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  requester  Employee @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  partner    Employee @relation("SwapPartner", fields: [partnerId], references: [id], onDelete: Restrict)
  approvedBy User?    @relation("SwapReviewer", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([requesterId, date, status])
  @@index([partnerId, date, status])
  @@index([status, createdAt])
}

enum PerformanceArea {
  PICKING
  PACKING
}

model PerformanceWorkstation {
  code          String          @id
  area          PerformanceArea
  targetPerHour Int?
  updatedAt     DateTime        @updatedAt
}

/// Vom Mitarbeiter selbst erfasste Leistung einer Schicht (Datum und Schicht werden serverseitig ermittelt).
model PerformanceEntry {
  id              String          @id @default(cuid())
  employeeId      String
  workDate        DateTime        @db.Date
  shift           ShiftCode
  area            PerformanceArea
  workstation     String
  quantity        Int
  durationMinutes Int
  /// Soll-Leistung (Stück/Std.) des Arbeitsplatzes zum Zeitpunkt der Erfassung
  targetPerHour   Int?
  note            String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("PerformanceRecorder", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId, workDate])
  @@index([workDate, area, workstation])
}

model Notification {
  id         String           @id @default(cuid())
  employeeId String?
  userId     String?
  title      String
  message    String
  type       NotificationType
  read       Boolean          @default(false)
  link       String?
  createdAt  DateTime         @default(now())
  readAt     DateTime?

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt, id])
  @@index([employeeId, read])
  @@index([userId, createdAt, id])
}

enum CompanyDayType {
  CLOSURE
  INVENTORY
  PLANT_HOLIDAY
  STAFF_MEETING
  SPECIAL_WORKDAY
  OTHER
}

model CalendarSettings {
  id        String   @id @default("default")
  country   String   @default("DE")
  state     String   @default("NW")
  updatedAt DateTime @updatedAt
}

model CompanyDay {
  id          String         @id @default(cuid())
  name        String
  date        DateTime       @db.Date
  type        CompanyDayType
  note        String?
  active      Boolean        @default(true)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy User? @relation("CompanyDayCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date, active])
}

model User {
  id                 String    @id @default(cuid())
  login              String    @unique
  email              String?   @unique
  passwordHash       String
  // Bestehende Konten bleiben unberührt (false); neue Konten und Admin-Resets setzen true.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  active             Boolean   @default(true)
  roleId             String
  employeeId         String?   @unique
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  role                        Role                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employee                    Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  approvedVacations           VacationRequest[]     @relation("VacationApprover")
  createdAbsences             Absence[]             @relation("AbsenceRecorder")
  auditLogs                   AuditLog[]
  createdTemporaryAssignments TemporaryAssignment[] @relation("TemporaryAssignmentCreator")
  createdCompanyDays          CompanyDay[]          @relation("CompanyDayCreator")
  reviewedShiftSwaps          ShiftSwapRequest[]    @relation("SwapReviewer")
  notifications               Notification[]
  recordedPerformance         PerformanceEntry[]    @relation("PerformanceRecorder")
  createdAdditionalShifts     AdditionalShift[]     @relation("AdditionalShiftCreator")
  releasedAdditionalShifts    AdditionalShift[]     @relation("AdditionalShiftReleaser")
  messageDispatches           MessageDispatch[]     @relation("MessageDispatchCreator")
  messageThreads              MessageThread[]       @relation("MessageThreadCreator")
  messageParticipants         MessageParticipant[]
  messages                    Message[]             @relation("MessageSender")

  @@index([active, roleId])
}

model Employee {
  id                   String   @id @default(cuid())
  firstName            String
  lastName             String
  personnelNumber      String   @unique
  email                String?  @unique
  isActive             Boolean  @default(true)
  annualLeaveAllowance Int      @default(30)
  carryOverLeaveDays   Int      @default(0)
  shiftModelId         String
  shiftGroupId         String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User?
  shiftModel           ShiftModel              @relation(fields: [shiftModelId], references: [id], onDelete: Restrict)
  shiftGroup           ShiftGroup              @relation(fields: [shiftGroupId], references: [id], onDelete: Restrict)
  departments          EmployeeDepartment[]
  permissions          EmployeePermission[]
  shiftAssignments     ShiftAssignment[]
  absences             Absence[]
  vacationRequests     VacationRequest[]
  vacationAccounts     VacationAccount[]
  qualifications       EmployeeQualification[]
  temporaryAssignments TemporaryAssignment[]
  notifications        Notification[]
  requestedShiftSwaps  ShiftSwapRequest[]      @relation("SwapRequester")
  receivedShiftSwaps   ShiftSwapRequest[]      @relation("SwapPartner")
  performanceEntries   PerformanceEntry[]
  additionalShifts     AdditionalShift[]
  messageParticipants  MessageParticipant[]

  @@index([lastName, firstName])
  @@index([isActive, shiftModelId, shiftGroupId])
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  users       User[]
  permissions RolePermission[]

  @@index([name])
}

model Permission {
  id          String               @id @default(cuid())
  key         String               @unique
  label       String
  description String?
  roles       RolePermission[]
  employees   EmployeePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  allowed      Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model EmployeePermission {
  employeeId   String
  permissionId String
  allowed      Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([employeeId, permissionId])
  @@index([permissionId, allowed])
}

model ShiftModel {
  id              String      @id @default(cuid())
  code            String      @unique
  name            String
  rotationOrder   ShiftCode[]
  workingWeekdays Int[]
  active          Boolean     @default(true)
  employees       Employee[]
}

model ShiftGroup {
  id         String     @id @default(cuid())
  code       String     @unique
  name       String
  startShift ShiftCode
  anchorDate DateTime   @db.Date
  active     Boolean    @default(true)
  employees  Employee[]
}

model Department {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees            EmployeeDepartment[]
  minimumStaffing      MinimumStaffing[]
  temporaryAssignments TemporaryAssignment[]
  additionalShifts     AdditionalShift[]

  @@index([active, name])
}

model EmployeeDepartment {
  employeeId   String
  departmentId String
  isPrimary    Boolean  @default(false)
  assignedAt   DateTime @default(now())

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([employeeId, departmentId])
  @@index([departmentId, isPrimary])
}

model TemporaryAssignment {
  id           String     @id @default(cuid())
  employeeId   String
  departmentId String
  startDate    DateTime   @db.Date
  endDate      DateTime   @db.Date
  shift        ShiftCode?
  note         String?
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  cancelledAt  DateTime?

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy  User?      @relation("TemporaryAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId, startDate, endDate])
  @@index([departmentId, startDate, endDate])
}

model ShiftAssignment {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime         @db.Date
  shift      ShiftCode
  source     AssignmentSource @default(ROTATION)
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date, shift])
}

model Absence {
  id           String        @id @default(cuid())
  seedKey      String?       @unique
  employeeId   String
  type         AbsenceType
  status       AbsenceStatus @default(RECORDED)
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  recordedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation("AbsenceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([employeeId, startDate, endDate])
  @@index([type, status, startDate])
}

model VacationRequest {
  id            String         @id @default(cuid())
  employeeId    String
  startDate     DateTime       @db.Date
  endDate       DateTime       @db.Date
  daysRequested Int
  status        VacationStatus @default(REQUESTED)
  comment       String?
  requestedAt   DateTime       @default(now())
  decidedAt     DateTime?
  approvedById  String?
  updatedAt     DateTime       @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy User?    @relation("VacationApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([employeeId, status, startDate, endDate])
  @@index([status, startDate])
}

model VacationAccount {
  id              String   @id @default(cuid())
  employeeId      String
  year            Int
  annualAllowance Int
  carryOverDays   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
}

model MinimumStaffing {
  id               String    @id @default(cuid())
  departmentId     String
  shift            ShiftCode
  minimum          Int       @default(0)
  qualificationId  String?
  minimumQualified Int       @default(0)
  updatedAt        DateTime  @updatedAt

  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  qualification Qualification? @relation(fields: [qualificationId], references: [id], onDelete: SetNull)

  @@unique([departmentId, shift])
}

model Qualification {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  employees       EmployeeQualification[]
  minimumStaffing MinimumStaffing[]
}

model EmployeeQualification {
  employeeId      String
  qualificationId String
  level           Int       @default(0)
  validFrom       DateTime?
  certifiedAt     DateTime  @default(now())
  validUntil      DateTime?
  note            String?

  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  qualification Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)

  @@id([employeeId, qualificationId])
  @@index([qualificationId, validUntil])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  occurredAt  DateTime @default(now())
  oldValues   Json?
  newValues   Json?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([entityType, entityId])
  @@index([actorUserId, occurredAt])
}
